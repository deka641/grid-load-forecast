  "info": {
    "title": "grid-load-forecast API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/actuals": {
      "get": {
        "description": "Return measured values for the local days ``start`` to ``end`` inclusive.",
        "operationId": "actuals_api_v1_actuals_get",
        "parameters": [
          {
            "description": "Comma-separated series keys from /api/v1/series (at most 20)",
            "in": "query",
            "name": "series",
            "required": true,
            "schema": {
              "description": "Comma-separated series keys from /api/v1/series (at most 20)",
              "examples": [
                "load,gen_solar"
              ],
              "maxLength": 1000,
              "title": "Series",
              "type": "string"
            }
          },
          {
            "description": "First local day (Europe/Berlin)",
            "in": "query",
            "name": "start",
            "required": true,
            "schema": {
              "description": "First local day (Europe/Berlin)",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "title": "Start",
              "type": "string"
            }
          },
          {
            "description": "Last local day (Europe/Berlin)",
            "in": "query",
            "name": "end",
            "required": true,
            "schema": {
              "description": "Last local day (Europe/Berlin)",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "title": "End",
              "type": "string"
            }
          },
          {
            "description": "hour: at most 366 days; quarterhour: at most 31 days",
            "in": "query",
            "name": "resolution",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Resolution",
              "default": "hour",
              "description": "hour: at most 366 days; quarterhour: at most 31 days"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Actuals"
                }
              }
            },
            "description": "Successful Response"
          },
          "304": {
            "description": "The ETag in If-None-Match is current; the data has not changed"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No readable data snapshot is available, or the server is busy"
          }
        },
        "summary": "Actuals",
        "tags": [
          "data"
        ]
      }
    },
    "/api/v1/backtest/metrics": {
      "get": {
        "description": "Return the metrics of the latest backtest run.",
        "operationId": "backtest_metrics_api_v1_backtest_metrics_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BacktestMetrics"
                }
              }
            },
            "description": "Successful Response"
          },
          "304": {
            "description": "The ETag in If-None-Match is current; the data has not changed"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No matching data in the snapshot"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No readable data snapshot is available, or the server is busy"
          }
        },
        "summary": "Backtest Metrics",
        "tags": [
          "forecasts"
        ]
      }
    },
    "/api/v1/forecasts": {
      "get": {
        "description": "Return hourly forecasts, the SMARD forecast and the actual load for one day.",
        "operationId": "forecasts_api_v1_forecasts_get",
        "parameters": [
          {
            "description": "Local delivery day (Europe/Berlin); default: the latest day with a lightgbm forecast",
            "in": "query",
            "name": "delivery_day",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Local delivery day (Europe/Berlin); default: the latest day with a lightgbm forecast",
              "title": "Delivery Day"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForecastDay"
                }
              }
            },
            "description": "Successful Response"
          },
          "304": {
            "description": "The ETag in If-None-Match is current; the data has not changed"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No matching data in the snapshot"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No readable data snapshot is available, or the server is busy"
          }
        },
        "summary": "Forecasts",
        "tags": [
          "forecasts"
        ]
      }
    },
    "/api/v1/forecasts/days": {
      "get": {
        "description": "List delivery days that have a forecast, newest first.",
        "operationId": "forecast_days_api_v1_forecasts_days_get",
        "parameters": [
          {
            "description": "Maximum number of days",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 400,
              "description": "Maximum number of days",
              "maximum": 5000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForecastDays"
                }
              }
            },
            "description": "Successful Response"
          },
          "304": {
            "description": "The ETag in If-None-Match is current; the data has not changed"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No readable data snapshot is available, or the server is busy"
          }
        },
        "summary": "Forecast Days",
        "tags": [
          "forecasts"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "description": "Report that the process is alive.",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "status"
        ]
      }
    },
    "/api/v1/series": {
      "get": {
        "description": "List the series this deployment serves.",
        "operationId": "series_api_v1_series_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SeriesCatalog"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Series",
        "tags": [
          "data"
        ]
      }
    },
    "/api/v1/status": {
      "get": {
        "description": "Report data freshness, licence and attribution; works without a snapshot.",
        "operationId": "status_api_v1_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Status",
        "tags": [
          "status"
        ]
      }
    }
  }
}
