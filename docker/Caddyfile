{
	admin off
	auto_https off
}

:8080 {
	# gzip first: clients that accept both without a preference (browsers, httpx) get
	# gzip. Under `make loadtest` the zstd encoders took this container past its 128 MB
	# memory limit; with gzip it peaked at 61 MiB. A client that asks for zstd only, or
	# ranks it higher, still gets zstd.
	encode gzip zstd

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
		-Via
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle /assets/* {
		root * /srv
		@found file
		header @found Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
