{
	admin off
	auto_https off
	servers {
		# A connection that has not sent its request header within 10 s is
		# closed, as is a keep-alive connection idle for 60 s. Half-open
		# connections cost this container about 16 KB each, so they must not
		# live long; the number open at once is bounded by the open file limit
		# of the web service in compose.yaml.
		timeouts {
			read_header 10s
			read_body 10s
			idle 60s
		}
	}
}

:8080 {
	# gzip only: under `make loadtest` the zstd encoders took this container past its
	# memory limit of then 128 MB, while gzip peaked at 56 MiB. Offering zstd would let any
	# client that asks for it exhaust the limit with parallel large downloads.
	encode gzip

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
		-Via
	}

	# At most 192 + 16 + 16 connections to the API, below uvicorn's
	# --limit-concurrency of 256: further requests wait here instead of being
	# refused by uvicorn. /health and /status have pools of their own, so a
	# flood of data requests does not hold the connections they need.
	handle /api/v1/health {
		reverse_proxy api:8000 {
			transport http {
				max_conns_per_host 16
			}
		}
	}

	handle /api/v1/status {
		reverse_proxy api:8000 {
			transport http {
				max_conns_per_host 16
			}
		}
	}

	handle /api/* {
		reverse_proxy api:8000 {
			transport http {
				max_conns_per_host 192
			}
		}
	}

	handle /assets/* {
		root * /srv
		@found file
		header @found Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
